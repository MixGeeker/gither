{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gither-catalog-local-prototype",
  "main": "cloudflare/index.ts",
  "compatibility_date": "2026-11-06",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "assets": {"directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*", "/mcp"]},
  "vars": {"APP_ORIGIN": "http://127.0.0.1:8787", "COLLECTION_ENABLED": "false"},
  "d1_databases": [{"binding":"DB", "database_name":"gither-catalog-local", "database_id":"00000000-0000-0000-0000-000000000000", "migrations_dir":"cloudflare/migrations"}],
  "triggers": {"crons": []}
}
