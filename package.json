{
  "name": "gither",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Project discovery with React, TypeScript 7, and three design systems",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 4173",
    "build": "tsc --noEmit && vite build && node scripts/build-sw.mjs",
    "check": "tsc --noEmit",
    "test": "npm run server:build && tsc -p tsconfig.test.json && tsc -p tsconfig.worker.json --noEmit false --rootDir worker --outDir .auth-dist && node --test tests/*.test.mjs",
    "auth:check": "tsc -p tsconfig.worker.json",
    "auth:build": "node scripts/build-auth.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "auth:smoke": "npm run auth:build && node scripts/auth-d1-smoke.mjs",
    "server:check": "tsc -p tsconfig.server.json",
    "server:build": "node scripts/build-server.mjs",
    "server:test": "npm run server:build && node --test tests/server-*.test.mjs",
    "start": "node .server-dist/index.js",
    "setup": "node .server-dist/cli.js setup",
    "selfhost:build": "VITE_SELF_HOSTED=true npm run build && npm run server:build",
    "catalog:check": "tsc -p tsconfig.cloudflare.json",
    "catalog:build": "npm run catalog:check && node scripts/build-catalog.mjs",
    "catalog:smoke": "npm run build && npm run catalog:build && node scripts/catalog-smoke.mjs",
    "dev:selfhost:qa": "npm run selfhost:build && node scripts/preview-selfhost.mjs"
  },
  "dependencies": {
    "better-auth": "1.7.17",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261104.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vite": "8.3.6",
    "wrangler": "4.158.0"
  }
}
